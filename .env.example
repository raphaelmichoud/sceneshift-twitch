PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
# Required for public deployment: use a long random password (at least 24 characters).
# Local-only development uses a generated key in data/admin.key when omitted.
ADMIN_KEY=
DATA_DIR=./data
# Optional. Register an app at https://dev.twitch.tv/console/apps
# Redirect URI must exactly equal BASE_URL + /auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: restrict authorization to one Twitch account's numeric user ID.
TWITCH_BROADCASTER_ID=
